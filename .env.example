# ---------------------------------------------------------------------------
# Speech-to-text engine
#
#   (empty)  -- ask in the browser on first load, before anything is loaded
#   local    -- Whisper on this Mac (MLX, GPU). Private, free.
#   openai   -- OpenAI audio API. Needs OPENAI_API_KEY (or a key typed into the
#               chooser, which is kept in server memory only). Billed per minute.
# Translation always runs locally either way.
# ---------------------------------------------------------------------------
# Skip the engine chooser: "openai" or "local". The browser goes straight to the
# talk-title question. (ASR_ENGINE is the older name for the same thing.)
FORCE_APPROACH=

# Shared phrase required before the page will do anything. Empty = no gate.
# Not per-user auth: it keeps the instance off the open internet, nothing more.
ACCESS_PASSPHRASE=

# Per-talk records (title, IP, models, running cost). Relative to the project.
DB_PATH=salindia.sqlite3

ASR_ENGINE=
OPENAI_API_KEY=
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe | gpt-transcribe
# whisper-1 is the Whisper V2 model and the only one with per-segment confidence
# (used by the hallucination filter) and with MODE=direct translation.
OPENAI_ASR_MODEL=whisper-1
# Chat model used for translation when the speech engine is OpenAI. With this
# engine nothing runs locally, which is what makes MODE=pipeline work on a
# machine without Apple Silicon.
OPENAI_MT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Live preview while speaking = one paid request per refresh. Off by default.
OPENAI_PARTIALS=0
# Speculative decoding starts the final decode during a mid-sentence pause. If
# the speaker carries on, that decode is discarded -- free on a local GPU, a
# wasted paid request against the API. Set to 1 to trade money for ~400ms.
OPENAI_SPECULATE=0

# ---------------------------------------------------------------------------
# Pipeline mode
#
#   pipeline (default) -- whisper large-v3-turbo transcribes Indonesian, then a
#                         small MLX LLM translates each finished sentence.
#                         Indonesian shows up live while you speak; English
#                         lands a beat later. Fastest option on Apple Silicon.
#
#   direct             -- whisper large-v3 with task="translate" emits English
#                         in one pass. No Indonesian shown, ~4-6x more compute
#                         per pass. Use if you want the single-model setup.
#
# This only says where the server starts. The mode is a dropdown in the top bar
# and can be switched during a talk; switching reloads the speech model and the
# translators, so open pages reconnect (the talk continues, you lose a sentence).
#
# Leave MODE unset and the OpenAI engine picks direct for itself: one
# /audio/translations call does speech and translation together, which is
# faster and cheaper than transcribing and then paying a chat model. That is
# ID -> EN only, so switch to pipeline in the bar for EN -> ID. Setting MODE
# here turns that off -- an explicit choice is always honoured.
# ---------------------------------------------------------------------------
MODE=pipeline

# ASR. In pipeline mode turbo is the right pick: 4 decoder layers instead of 32,
# and its *transcription* is excellent -- only its translate task is degraded,
# which this mode never uses.
ASR_MODEL=mlx-community/whisper-large-v3-turbo
# Used only when MODE=direct (turbo would be a bad choice there).
ASR_MODEL_DIRECT=mlx-community/whisper-large-v3-mlx

# Indonesian output style: formal (saya/Anda), casual (aku/kamu), match (follow
# the speaker). Default for new pages; the Context button changes it per page.
ID_STYLE=formal

# Direction a new page starts in (the UI toggle switches it). direct mode: id-en only.
DIRECTION=id-en

# Text translators for MODE=pipeline, one per direction. Same repo = loaded once.
#   Qwen3-4B-Instruct-2507-4bit  ~2.4 GB  good ID->EN, ~0.9s/sentence
#   Qwen3-8B-4bit                ~4.6 GB  much better EN->ID (keeps currencies,
#                                         consistent saya/aku), ~1.7s/sentence
# On a 16 GB Mac, point both at the 4B model.
# Tested and rejected: gemma-3-4b-it-4bit (broke character, wrong register).
MT_MODEL_ID_EN=mlx-community/Qwen3-4B-Instruct-2507-4bit
MT_MODEL_EN_ID=mlx-community/Qwen3-8B-4bit

# Streaming behaviour
PARTIAL_WINDOW_S=8          # partials only re-decode this much trailing audio
SILENCE_MS=650              # trailing silence that ends an utterance
SOFT_MAX_S=6                # past this, a short breath ends the utterance...
SHORT_SILENCE_MS=250        # ...this short (keeps subtitles short and timely)
MAX_UTTERANCE_S=12          # hard cap; cut at the quietest point of the last 2s
MIN_UTTERANCE_MS=350        # ignore blips shorter than this
SPECULATE_AFTER_MS=250      # start the final decode during the pause (0 = off)
FINAL_WORKERS=3             # sentences in flight at once; the GPU still runs one
                            # model call at a time (see server/gpu.py)
# Stop listening after this many seconds with no speech. The browser stops its own
# capture and the server keeps its own clock, so a wedged or closed page cannot
# leave a paid stream running. 0 disables.
IDLE_STOP_S=60

# Voice activity detection
VAD_ABS_THRESHOLD=0.006     # absolute RMS floor; raise it in a noisy room
VAD_NOISE_RATIO=3.0         # speech must exceed this x the measured noise floor

HOST=127.0.0.1
PORT=8000
